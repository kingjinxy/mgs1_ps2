/* ps2sdk's ee/startup/linkfile with the HAL's scratchpad section (copied from the SH1 port's tools/port/linkfile; build/link_ps2.py). */

/*
# _____     ___ ____     ___ ____
#  ____|   |    ____|   |        | |____|
# |     ___|   |____ ___|    ____| |    \    PS2DEV Open Source Project.
