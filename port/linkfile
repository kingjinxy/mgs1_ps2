# Licenced under Academic Free License version 2.0
# Review ps2sdk README & LICENSE files for further details.
#
# Linkfile script for ee-ld
*/

ENTRY(__start);

PHDRS {
  text PT_LOAD;
}

SECTIONS {
	.text 0x00100000: {
		_ftext = . ;
		*(.text)
		*(.text.*)
		*(.gnu.linkonce.t*)
		KEEP(*(.init))
		KEEP(*(.fini))
		QUAD(0)
	} :text

	PROVIDE(_etext = .);
	PROVIDE(etext = .);

	/* Global/static constructors and deconstructors. */
	.ctors ALIGN(16): {
		KEEP(*crtbegin*.o(.ctors))
		KEEP(*(EXCLUDE_FILE(*crtend*.o) .ctors))
		KEEP(*(SORT(.ctors.*)))
		KEEP(*(.ctors))
	}
	.dtors ALIGN(16): {
		KEEP(*crtbegin*.o(.dtors))
		KEEP(*(EXCLUDE_FILE(*crtend*.o) .dtors))
		KEEP(*(SORT(.dtors.*)))
		KEEP(*(.dtors))
	}

	.reginfo : { *(.reginfo) }

	.data ALIGN(128): {
		_fdata = . ;
		*(.data)
		*(.data.*)
		*(.gnu.linkonce.d*)
		SORT(CONSTRUCTORS)
	}

	/* Static data.  */
	.rodata ALIGN(128): {
		*(.rodata)
		*(.rodata.*)
		*(.gnu.linkonce.r*)
	}

	.rdata ALIGN(128): { *(.rdata) }
	.gcc_except_table ALIGN(128): { *(.gcc_except_table) }

	_gp = ALIGN(128) + 0x7ff0;
	.lit4 ALIGN(128): { *(.lit4) }
	.lit8 ALIGN(128): { *(.lit8) }

	.sdata ALIGN(128): {
		*(.sdata)
		*(.sdata.*)
		*(.gnu.linkonce.s*)
	}

	_edata = .;
	PROVIDE(edata = .);

	/* Uninitialized data.  */
	.sbss ALIGN(128) : {
		_fbss = . ;
		*(.sbss)
		*(.sbss.*)
		*(.gnu.linkonce.sb*)
		*(.scommon)
	}

	.bss ALIGN(128) : {
		/* g_PsxRam and, 2 MB on, g_PsxScratch: at a multiple of the scratchpad's size, as translated stage code
		   (mips2c.py) builds scratchpad addresses the PS1's way, lui 0x1f80 then ori */
		. = ALIGN(0x400);
		*psx_mem.o(.bss)
		*(EXCLUDE_FILE(*gpu_gs.o *movie_ps2.o *strdec.o *psx_card.o) .bss EXCLUDE_FILE(*gpu_gs.o *movie_ps2.o *strdec.o *psx_card.o) .bss.*)
		*(.gnu.linkonce.b*)
		*(COMMON)
	}
	_end_bss = .;
	/* The PS1 executable's end of BSS (mts_get_bss_tail): for now the ELF's. */
	_bss_orgend = .;
	/* The HAL's ordering tables keep PS1-style 24-bit links (libgpu_port.c ptr24): every OT and primitive the
	   game links (its .data/.bss, the PS1 RAM) must be below 16 MB, or the links wrap (TLB misses in
	   DrawOTagImpl). */
	ASSERT(_end_bss <= 0x1000000, "game data past 16 MB: the ordering tables' 24-bit links would wrap")

	/* The HAL's big buffers (VRAM, movie and stream decoders, memory card image: 3.5 MB), which no ordering table
	   links: past the 16 MB line, to leave the room below it to the game. crt0 zeroes up to _end. */
	.bss_high ALIGN(128) : { *gpu_gs.o(.bss .bss.*) *movie_ps2.o(.bss .bss.*) *strdec.o(.bss .bss.*) *psx_card.o(.bss .bss.*) }

	ASSERT((g_PsxScratch & 0x3ff) == 0, "g_PsxScratch isn't aligned to its size: an ori onto it would go wrong")
	_end = . ;
	PROVIDE(end = .);

	/* The scratchpad (include/port/spr.h): NOLOAD, so it isn't in the ELF's load segment; main() zeroes it. */
	.spad 0x70000000 (NOLOAD): {
		_spad_start = .;
		*(.spad)
		_spad_end = .;
	}
	ASSERT(_spad_end <= 0x70004000, "scratchpad (.spad) over 16 KB")

	/* Symbols needed by crt0.s.  */
	PROVIDE(_heap_size = -1);
	PROVIDE(_stack = -1);
	PROVIDE(_stack_size = 128 * 1024);
}
